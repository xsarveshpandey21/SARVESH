# =============================================================================
# ENVIRONMENT CONFIGURATION FOR SARVESH PANDEY LOOKBOOK PORTFOLIO
# =============================================================================

# Formspree endpoint URL (e.g., https://formspree.io/f/mqazkxyz)
# If empty or left as placeholder, the contact form operates in interactive client demo mode with instant confetti feedback.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/placeholder

# Optional: GitHub Personal Access Token (PAT)
# WARNING: If configured, this token MUST be READ-ONLY and public-scope only (no repo write, no admin permissions).
# Without a token, the unauthenticated GitHub REST API limit is 60 requests/hour.
# With a read-only token, the limit increases to 5,000 requests/hour.
# If offline or rate-limited, the application automatically falls back to curated production projects in data/fallbackProjects.ts.
VITE_GITHUB_TOKEN=
